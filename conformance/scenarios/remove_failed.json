    {"op": "send", "message": {"command": "test_manifest"}},
    {"op": "expect_manifest", "tree": false},
    {"op": "send", "message": {"command": "run_test_cases", "test_case_ids": ["case-fail"]}},
    {"op": "expect_result", "id": "case-fail", "status": "failed"},
    {"op": "send", "message": {"command": "remove_failed_test_case_result", "test_case_id": "case-fail"}},
    {"op": "send", "message": {"command": "close", "exit_status": null}},
    {"op": "expect_report", "connection_retries": 0, "suite_hooks": 1, "group_hooks": 1},
    {"op": "expect_exit", "code": 0}
  ]
}
