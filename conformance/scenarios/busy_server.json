{
  "name": "busy_server",
  "no_keepalive_env": true,
  "steps": [
    {
      "op": "send",
      "message": {
        "command": "connected"
      }
    },
    {
      "op": "send",
      "message": {
        "command": "test_manifest"
      }
    },
    {
      "op": "expect_manifest",
      "tree": false
    },
    {
      "op": "send",
      "message": {
        "command": "run_test_cases",
        "test_case_ids": [
          "case-pass",
          "case-pend"
        ]
      }
    },
    {
      "op": "busy",
      "ms": 3000
    },
    {
      "op": "expect_result",
      "id": "case-pass",
      "status": "passed"
    },
    {
      "op": "expect_result",
      "id": "case-pend",
      "status": "pending"
    },
    {
      "op": "send",
      "message": {
        "command": "close",
        "exit_status": null
      }
    },
    {
      "op": "expect_report",
      "connection_retries": 0
    },
    {
      "op": "expect_exit",
      "code": 0
    }
  ]
}
